# ---------------------------------------------------------------------------
# tally / finmcp — copy to .env and fill in. NEVER commit .env.
# ---------------------------------------------------------------------------

# --- server -----------------------------------------------------------------
PORT=8787
# openssl rand -hex 32
MCP_SECRET=
# sqlite file. In Docker set to /data/finmcp.db
DB_PATH=data/finmcp.db
# requests per minute allowed on the MCP route (per IP)
MCP_RATE_LIMIT=60
# Keep the legacy /mcp/<secret> route alive. Leave on until the connector has
# been re-added via OAuth (sign-in), then set false: a secret in a URL path is
# written to reverse-proxy access logs on every request.
MCP_ALLOW_PATH_SECRET=true
# number of reverse-proxy hops in front of the app. 0 = direct.
# Behind Traefik/Dokploy/nginx set this to 1, or req.ip is the proxy's address
# for every request and the per-IP rate limit becomes one global bucket.
TRUST_PROXY=0
LOG_LEVEL=info

# --- household --------------------------------------------------------------
BASE_CURRENCY=CAD
# Profile a newly discovered account is filed under. Profiles are created in the
# UI; each has its own provider credentials and its own Plaid Item allowance.
DEFAULT_OWNER=me

# --- nightly sync (inside the container) ------------------------------------
# 24h local-time hour/minute for the nightly sync. Empty CRON_ENABLED disables.
CRON_ENABLED=true
CRON_HOUR=4
CRON_MINUTE=15
# keep this many daily sqlite backups next to the db
BACKUP_KEEP_DAYS=14

# --- SnapTrade (Personal API key) -------------------------------------------
SNAPTRADE_CLIENT_ID=
SNAPTRADE_CONSUMER_KEY=
# rest (default, omits userId/userSecret — required for Personal keys) | sdk
SNAPTRADE_TRANSPORT=rest
# only needed when SNAPTRADE_TRANSPORT=sdk, or for a Commercial key
SNAPTRADE_USER_ID=
SNAPTRADE_USER_SECRET=
# Chase cards arrive through SnapTrade with $0 balances; Plaid owns cards.
EXCLUDE_SNAPTRADE_CARDS=true
# experimental balance-history backfill (enable the add-on in the dashboard)
SNAPTRADE_BALANCE_HISTORY=false

# --- Plaid ------------------------------------------------------------------
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=production
PLAID_PRODUCTS=transactions
# Fetched best-effort; never blocks Link or limits which institutions appear.
# Add `statements` to enable statement downloads — but note products are fixed
# when an Item is linked, so existing connections must be re-consented.
PLAID_OPTIONAL_PRODUCTS=liabilities
PLAID_COUNTRY_CODES=US,CA
PLAID_LINK_PORT=8788
PLAID_REDIRECT_URI=http://localhost:8788/oauth-return
PLAID_TRANSACTION_DAYS=730
# Statement window requested at link time. Plaid's own cap is 24 months.
PLAID_STATEMENT_MONTHS=24

# --- Wise -------------------------------------------------------------------
# read-only token: Wise -> Settings -> API tokens
WISE_API_TOKEN=
WISE_API_BASE=https://api.transferwise.com

# --- web UI (optional; off by default) --------------------------------------
# When false the server is a bare MCP endpoint with no login surface at all.
UI_ENABLED=false
ADMIN_USERNAME=
# Argon2id hash — NOT the password. Generate with: npm run hash-password
# The password itself is never stored anywhere, here or in the database.
# Contains `$`, which a shell expands: unquoted in .env is fine, but wrap it in
# SINGLE quotes anywhere a shell reads it (docker run -e, inline VAR=...), or
# you will set an empty hash and lock yourself out.
# Turn on two-factor from the Security page straight after your first sign-in.
ADMIN_PASSWORD_HASH=
# Send the session cookie only over HTTPS. Defaults on when TRUST_PROXY > 0.
COOKIE_SECURE=
# Failed sign-ins allowed per 15 minutes, per address. Successes do not count.
LOGIN_RATE_LIMIT=10

# --- optional built-in assistant (off unless configured) ---------------------
# A chat page that answers from your accounts. Turning it on means this server
# sends balances and transactions to that provider on every message — a
# different trade from the rest of the app, where data only leaves in response
# to a request your own MCP client made. If you already use Claude, the MCP
# connector gives the same answers without a second copy leaving the box.
# anthropic | openai | openrouter | custom
LLM_PROVIDER=anthropic
# Secret. Stored encrypted when set through Settings.
LLM_API_KEY=
# Blank uses the provider default.
LLM_MODEL=
# Only for a custom or self-hosted OpenAI-compatible endpoint.
LLM_BASE_URL=
# Tool round trips one answer may take before it must conclude.
LLM_MAX_STEPS=8
LLM_TIMEOUT_MS=120000

# --- at-rest encryption for plaid access tokens -----------------------------
# openssl rand -hex 32   (AES-256-GCM). Set it and existing rows migrate once.
# BACK THIS UP somewhere other than the server. It decrypts every stored
# provider secret and bank access token; losing it means re-linking every bank.
# Changing it does not re-encrypt existing rows — they become unreadable.
TOKEN_ENC_KEY=

# Full walkthrough for every provider, the password hash and 2FA:
#   docs/SETUP.md
